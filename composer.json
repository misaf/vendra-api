{
	"name": "misaf/vendra-api",
	"description": "API services for the vendra-api module",
	"license": "MIT",
	"type": "vendra-module",
	"keywords": [
		"laravel",
		"filamentphp",
		"misaf",
		"vendra",
		"api"
	],
	"authors": [
		{
			"name": "Ehsan Mahmoodi",
			"email": "misaf.1990@gmail.com",
			"role": "Developer"
		}
	],
	"homepage": "https://github.com/misaf/vendra-api",
	"support": {
		"issues": "https://github.com/misaf/vendra-api/issues",
		"source": "https://github.com/misaf/vendra-api"
	},
	"require": {
		"php": "^8.2",
		"illuminate/support": "^11.0 || ^12.0",
		"laravel-json-api/laravel": "^5.0",
		"spatie/laravel-package-tools": "^1.92"
	},
	"require-dev": {
		"fakerphp/faker": "^1.24.1",
		"larastan/larastan": "^3.9.2",
		"laravel-json-api/testing": "^3.1",
		"laravel/boost": "^2.0.6",
		"laravel/pint": "^1.27",
		"mockery/mockery": "^1.6.12",
		"nunomaduro/collision": "^8.8.3",
		"orchestra/testbench": "^10.9",
		"pestphp/pest": "^4.3.2",
		"pestphp/pest-plugin-arch": "^4.0",
		"pestphp/pest-plugin-laravel": "^4.0",
		"pestphp/pest-plugin-profanity": "^4.2.1",
		"pestphp/pest-plugin-type-coverage": "^4.0.3"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Misaf\\VendraApi\\": "src/",
			"Misaf\\VendraApi\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"php-http/discovery": true
		},
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"sort-packages": true
	},
	"extra": {
		"laravel": {
			"providers": [
				"Misaf\\VendraApi\\Providers\\ApiServiceProvider"
			]
		}
	},
	"$schema": "https://getcomposer.org/schema.json"
}
